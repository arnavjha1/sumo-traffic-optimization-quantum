<configuration>
    <input>
        <net-file value="grid3x3_tls.net.xml"/>
        <route-files value="routes_3x3/routes3x3_a6.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="30000"/>
    </time>

    <processing>
        <ignore-route-errors value="true"/>
    </processing>

    <report>
        <no-step-log value="true"/>
    </report>
</configuration>
