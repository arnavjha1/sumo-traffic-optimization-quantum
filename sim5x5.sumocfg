<configuration>
    <input>
        <net-file value="grid_5x5/grid5x5_tls.net.xml"/>
        <route-files value="grid_5x5/routes.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="30000"/>
    </time>

    <processing>
        <ignore-route-errors value="true"/>
    </processing>

    <report>
        <no-step-log value="true"/>
    </report>
</configuration>
